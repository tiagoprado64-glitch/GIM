# ==================================================
# FitFlow SaaS - Environment Variables
# ==================================================
# Copy this file to .env.local and fill in the values.
# On Vercel, add these in: Settings → Environment Variables

# SUPABASE: Required for database and authentication.
# Get these from your Supabase project dashboard (Settings → API).
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# GEMINI_API_KEY: Required for AI workout generation.
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"

# STRIPE: Required for subscription/payment management.
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# APP_URL: Your production URL on Vercel (no trailing slash).
# Locally: http://localhost:3000
# Production: https://your-app.vercel.app
APP_URL="http://localhost:3000"
